def set_var_lang(var):
	EN_FILE = 'misc/en_US.dat'
	BR_FILE = 'misc/pt_BR.dat'

	match INT_LANG:
		case 'en':
			with open(PATH+EN_FILE) as file:
				for line in file:
					line_row=line.split('=')
					if line_row[0] == var:
						TEXT = line_row[1].split(';')
						if len(TEXT) == 1:
							TEXT = str(TEXT[0].replace('\n',''))
						else:
							TEXT[len(TEXT)-1] = TEXT[len(TEXT)-1].replace('\n','')
		case 'br':
			with open(PATH+EN_FILE) as file:
				for line in file:
					line_row=line.split('=')
					if line_row[0] == var:
						TEXT = line_row[1].split(';')
						if len(TEXT) == 1:
							TEXT = str(TEXT[0].replace('\n',''))
						else:
							TEXT[len(TEXT)-1] = TEXT[len(TEXT)-1].replace('\n','')

	return TEXT

