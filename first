					SYSTEMDISK = '/dev/sda'
				if VDA:	
					SYSTEMDISK = '/dev/vda'
				DEFINED_SYSTEMDISK = True
	else:
		EFI = False
		ROOT = False

		mount_mnt = subprocess.run(['sh','-c','mount | grep /mnt'], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
