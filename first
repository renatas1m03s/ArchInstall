def set_systemdisk(term, position):
	global SYSTEMDISK
	close_loop = False
	blk_devices_itens = ['0']

	lsblk = subprocess.run(['sh','-c','lsblk -a -o NAME,SIZE,TYPE,MODEL | grep disk | awk \'{print "Device: /dev/"$1" - Size: "$2" - Model: "$4" "$5" "$6" "$7}\''], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
	lsbblk_lines = lsblk.stdout.decode('utf-8').splitlines()	

	for i, item in enumerate(lsbblk_lines):
		if i==0:
			blk_devices_itens[0] = str(item)
		else:
			blk_devices_itens.append(str(item))

	position = resolve_uw_display(term)
	preserv_position = list((position[0],position[1]))

	while close_loop != True:
		position = preserv_position
		print(term.move_yx(position[0],position[1])+term.clear_eos())
		selected_item = choices_single_option(term, position, blk_devices_itens, 'Choose SYSTEM DISK')
		if selected_item != '0':
			SYSTEMDISK = selected_item.split()[1]
			position = resolve_uw_display(term)
			text = text_justify_left(term, position, set_var_lang('ACCEPT_SYSTEM_DISK')[0] +term.bold(SYSTEMDISK)+set_var_lang('ACCEPT_SYSTEM_DISK')[1])
			print(text)
			position[1] = position[1]+term.length(text)+2
			select_item=choices_horizontal_menu(term, position,YES_OR_NO)
			if select_item==YES_OR_NO[0]:
				close_loop = True
				return True
		else:
			position = resolve_uw_display(term)
			text = text_justify_left(term, position, set_var_lang('NO_SYSTEM_DISK'))
			print(text)
			position[1] = position[1]+(term.length(set_var_lang('NO_SYSTEM_DISK'))+2)
			select_item=choices_horizontal_menu(term, position,YES_OR_NO)
			if select_item==YES_OR_NO[0]:
				close_loop = True
				return False
			
def set_dualboot(term, position):
	global freespace_itens
	
	freespace = subprocess.run(['sh','-c','parted -s ' + SYSTEMDISK + ' print free | grep Free'], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
	freespace_lines = freespace.stdout.decode('utf-8').splitlines()
	
	freespace_itens = ['0']
	for i,line in enumerate(freespace_lines):
		if i==0:
			freespace_itens[0] = line.split()
		else:
			freespace_itens.append(line.split())
			
	i=0
	freespace_menu = ['0']
	while i < len(freespace_lines):
		if i == 0:
			freespace_menu[0]='Area ' + str(i+1) + ' size: ' + freespace_itens[i][2]
		else:
			freespace_menu.append('Area ' + str(i+1) + ' size: ' + freespace_itens[i][2])
		i+=1
	
	selected_area = choices_single_option(term, position, freespace_menu, 'Choose where to install Arch:')
	i = freespace_menu.index(selected_area)
	
	return i

