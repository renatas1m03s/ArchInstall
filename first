def chroot_packages(term):
	PACKAGES_FILE_PATH = PATH + 'misc/first-packages.dat'
	PACKAGES = ''
	ALL_PACKAGES = {'BASE': True, 'LTS':LTS, 'ZEN':ZEN, 'MESA':MESA, 'NVIDIA':NVIDIA, 'GNOME_BASIC':GNOME_BASIC,
	                'PLASMA_BASIC':PLASMA_BASIC, 'CHROMIUM':CHROMIUM, 'FIREFOX':FIREFOX, 'THUNDERBIRD':THUNDERBIRD,
	                'LIBREOFFICE':LIBREOFFICE, 'VLC':VLC, 'GEANY':GEANY, 'CONKY':CONKY, 'EXTRAS':EXTRAS}
	                    
	ALL_PACKAGES_KEYS = ALL_PACKAGES.keys()

	with open(PACKAGES_FILE_PATH) as file:
		PACKAGES_DAT = file.readlines()
		for idx1,PACKAGES_DAT_LINE in enumerate(PACKAGES_DAT):
			for idx2, ALL_PACKAGES_KEYS_LINE in enumerate(ALL_PACKAGES_KEYS):
				if ALL_PACKAGES[ALL_PACKAGES_KEYS_LINE]:
					if PACKAGES_DAT_LINE.find(ALL_PACKAGES_KEYS_LINE)!=-1:
						PACKAGES_SWAP = PACKAGES_DAT_LINE.split('=')
						PACKAGES = PACKAGES + PACKAGES_SWAP[1].replace('\n','')

	result1 = subprocess.run(['sh', '-c','cp -v /etc/pacman.d/mirrorlist /mnt/etc/pacman.d/mirrorlist'])
	result2 = subprocess.run(['sh', '-c','arch-chroot /mnt pacman -Sy --noconfirm --needed ' + PACKAGES])

	with open(COMPLETE_LOG_FILE_NAME,'a+') as logfile:
		logfile.write(str(result1)+'\n' + str(result2)+'\n')
	pass 

