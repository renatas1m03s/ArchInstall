		mkdir_efi             = 'mkdir -p /mnt/boot/efi'
		mount_efi             = 'mount ' + SYSTEMDISK + efi_number + ' /mnt/boot/efi'

		for i, command_to_run in enumerate([create_gpt_label, create_efi_partition, create_root_partition, format_efi, format_root, mount_root, mkdir_efi, mount_efi, mkswapfile, swapon]):
