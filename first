					case 6:
						text = 'Mounting EFI partition'
					case 7:
						text = 'Creating swapfile'
					case 8:
						text = 'Enabling swapfile'
				cmd = ['sh','-c',command_to_run]
				position = resolve_uw_display(term) 	
				popen_progress(term, position, text, cmd)
				
	if DUALBOOT:
		position = resolve_uw_display(term)
		i = set_dualboot(term, position)	
		
		create_root_partition = 'parted -s --align optimal ' + SYSTEMDISK + ' mkpart ROOT ext4 ' + freespace_itens[i][0] + ' ' + freespace_itens[i][1]
		cmd = ['sh','-c',create_root_partition]
		result = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
		popen_progress(term, position, 'Configuring disks', cmd)
					
		device_id_command = subprocess.run(['sh','-c','blkid | grep ' + SYSTEMDISK + ' | grep ROOT | awk -F\':\' \'{print $1}\''], stdout=subprocess.PIPE, stderr=subprocess.PIPE)	
		device_id = device_id_command.stdout.decode('utf-8').splitlines()
		device_id = device_id[0]
		format_root = 'mkfs.ext4 -F -L Root ' + str(device_id)
		mount_root  = 'mount ' + str(device_id) + ' /mnt'
		
		EFI_id_command = subprocess.run(['sh','-c','fdisk -l ' + SYSTEMDISK + ' | grep EFI' ], stdout=subprocess.PIPE, stderr=subprocess.PIPE)	
		EFI_id = EFI_id_command.stdout.decode('utf-8').splitlines()
		EFI_id = EFI_id[0].split()
		EFI_id = EFI_id[0]
		
		mkdir_efi = 'mkdir -p /mnt/boot/efi'
		mount_efi = 'mount ' + str(EFI_id) + ' /mnt/boot/efi'
		
		for i, command_to_run in enumerate([format_root, mount_root, mkdir_efi, mount_efi, mkswapfile, swapon]):
			if command_to_run != '0':
				match i:
					case 0:
						text = 'Formating root'
					case 1:
						text = 'Mounting root'
					case 2:
						text = 'Creating EFI dir'
					case 3:
						text = 'Mounting EFI'
					case 4:
						text = 'Creating swapfile'
					case 4:
						text = 'Enabling swapfile'
				position = resolve_uw_display(term)
				cmd = ['sh','-c',command_to_run]
				popen_progress(term, position, text, cmd)
 
	x = time.localtime()
	sufix = str(x.tm_year)+'.'+str(x.tm_mon)+'.'+str(x.tm_mday)+'.'+str(x.tm_hour)+str(x.tm_min)

