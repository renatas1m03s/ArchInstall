			logfile.write(str(result)+'\n')
				
		device_id_command = subprocess.run(['sh','-c','blkid | grep ' + SYSTEMDISK + ' | grep ROOT | awk -F\':\' \'{print $1}\''], stdout=subprocess.PIPE, stderr=subprocess.PIPE)	
		device_id = device_id_command.stdout.decode('utf-8').splitlines()
		device_id = device_id[0]
		format_root = 'mkfs.ext4 -F -L Root ' + str(device_id)
		mount_root  = 'mount ' + str(device_id) + ' /mnt'
		
		EFI_id_command = subprocess.run(['sh','-c','fdisk -l ' + SYSTEMDISK + ' | grep EFI' ], stdout=subprocess.PIPE, stderr=subprocess.PIPE)	
		EFI_id = EFI_id_command.stdout.decode('utf-8').splitlines()
		EFI_id = EFI_id[0].split()
