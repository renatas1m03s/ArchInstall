		for command_to_run in [format_root, mount_root, mkdir_efi, mount_efi, mkswapfile, swapon]:
			if command_to_run != '0':
				result = subprocess.run(['sh','-c', command_to_run])
				with open(COMPLETE_LOG_FILE_NAME,'a+') as logfile:
					logfile.write(str(result)+'\n')
 
	x = time.localtime()
