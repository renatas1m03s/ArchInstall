		result = subprocess.run(['sh','-c','mv -v /mnt/home/' + USERNAME + ' /mnt/home/'+USERNAME+'.'+sufix])
		with open(COMPLETE_LOG_FILE_NAME,'a+') as logfile:
			logfile.write(str(result)+'\n')

	return True

def read_files(file_name):
	try:
		file = open(PATH+file_name)
		packages = ''
		for package in file:
			if packages == '':
				packages = package.replace('\n','')
			else:
				packages = packages + ' ' + package.replace('\n','')
		file.close()
		return packages
	except Exception:
		packages = '0'
		return packages

