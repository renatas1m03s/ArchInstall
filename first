def set_msfonts():
	MSFONTS_PATH = '/mnt/usr/share/fonts/WindowsFonts'
	MSFONTS_FILE = PATH + 'assets/msfonts.7z.001'
	
	try:
		os.makedirs(MSFONTS_PATH)
		
	except FileExistsError:
		print(f"One or more directories in '{MSFONTS_PATH}' already exist.")
	except PermissionError:
		print(f"Permission denied: Unable to create '{MSFONTS_PATH}'.")
	except Exception as e:
		print(f"An error occurred: {e}")
	result1 = subprocess.run(['sh', '-c','7z e ' + MSFONTS_FILE + ' -o' + MSFONTS_PATH + '/'])
	result2 = subprocess.run(['sh', '-c','arch-chroot /mnt fish -c \'chmod 644 ' + MSFONTS_PATH + '/*\''])
	result3 = subprocess.run(['sh', '-c','arch-chroot /mnt fc-cache –force'])
	with open(COMPLETE_LOG_FILE_NAME,'a+') as logfile:
		logfile.write(str(result1)+'\n'+str(result2)+'\n'+str(result3)+'\n')
	pass 

