def popen_progress(term, position, text, cmd, TIMER_LIMIT = 480):
	index = 0 
	TIMER = 0
	result = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
	while True:
		if TIMER >= (TIMER_LIMIT / 2):
			result.terminate()
		if (result.poll() is not None):
			break
		index = show_progress(term, position, text, index)
		time.sleep(2)
		TIMER +=1

	text=text_justify_left(term, position, text)
	print(text + term.clear_eol())

	with open(COMPLETE_LOG_FILE_NAME,'a+') as logfile:
		logfile.write('\nCommand: ' + str(cmd) + '\nCommand return:' + str(result.poll()) + '\n' + str(result)+'\n')

