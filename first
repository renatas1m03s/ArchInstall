		print(text_justify_left(term, position,'Pre-defined custom mount points:'))
		position[0] = position[0] + 2

		if len(mount_mnt_lines) >=1:
			for idx, lines in enumerate(mount_mnt_lines):
				print(text_justify_left(term, position, '-' + lines.replace('\n','') + str(position[0])))
				if (lines.find('vfat') != -1) and (lines.find('boot') != -1): EFI = True
				if (lines.find('ext4') != -1) and (lines.find('/mnt ') != -1): ROOT = True
				position[0] = position[0] + 1
			position[0] = position[0] + 1
			if EFI and ROOT: 
				DEFINED_SYSTEMDISK = True
			else:
				print(text_justify_left(term, position,'Need a EFI Vfat and a ROOT ext4 partitions to proceed!!'))
				key = term.inkey()
	if select_items =='0' or DEFINED_SYSTEMDISK == False:
		return False
	else:
		return True

