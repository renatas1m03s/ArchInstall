def virtualization(term, position):
	FINISH = False
		
	while FINISH == False:
		text = text_justify_left(term, position, 'Install QEMU and Virt-Manager?')
		print(text)
		position[0] += 1
		select_item=choices_horizontal_menu(term, position,YES_OR_NO)
		if select_item == YES_OR_NO[0]:
			subprocess.run(['sh', '-c','sudo pacman -Rdd --noconfirm iptables'])
			subprocess.run(['sh', '-c','sudo pacman -Sy --needed --noconfirm qemu-full virt-manager dnsmasq iptables-nft edk2-ovmf swtpm'])
			subprocess.run(['sh', '-c','sudo sudo systemctl enable libvirtd'])
			subprocess.run(['sh', '-c','sudo virsh net-autostart default'])
			subprocess.run(['sh', '-c','sudo usermod $USER -aG libvirt'])
			FINISH = True
			YAY = True
			return True
		else:
			FINISH = True
			return False	
	
def install_packages():

	PACKAGES_FILE_PATH = PATH + 'misc/second-packages.dat'
	PACKAGES = ''
	ALL_PACKAGES_KEYS = PACKAGES_OPTIONS.keys()

	with open(PACKAGES_FILE_PATH) as file: # Open the file with packages names
		PACKAGES_DAT = file.readlines() # Set packages_dat list variable where every line is a position
		for idx1,PACKAGES_DAT_LINE in enumerate(PACKAGES_DAT): # Pass every single line present in the file
			for idx2, ALL_PACKAGES_KEYS_LINE in enumerate(ALL_PACKAGES_KEYS): # Test every key in dictionary variable
				if PACKAGES_OPTIONS[ALL_PACKAGES_KEYS_LINE]: # if Value == True, then
					if PACKAGES_DAT_LINE.find(ALL_PACKAGES_KEYS_LINE)!=-1: # IF file line has a KEY
						PACKAGES_SWAP = PACKAGES_DAT_LINE.split('=')
						PACKAGES = PACKAGES + PACKAGES_SWAP[1].replace('\n','')

	subprocess.run(['sh', '-c','yay -Sy --noconfirm --needed' + PACKAGES])
	pass 

