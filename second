def main():
	STEP = 1
	PRINTABLE_AREA = 100
	position = list((0,0))

	 # If on gnome, customize wallpaper, icons and color appearence
	term = blessed.Terminal()
	text_set_printable_area(term, PRINTABLE_AREA) # Define the usable area of screen (columns)
	initial_args(sys.argv)
	set_int_lang(term, INT_LANG)
	gnome_kde()

	with term.fullscreen():
		try:
			while True:
				match STEP:
					case 1: # Print inital statements and disk setup step
						permanent_title(term, PROGRAM_TITLE2) # Set the header with PROGRAM_TITLE text
						position = resolve_uw_display(term)
						preserv_position = position
						text_print_list(term, position, WELCOME_TEXT2)
						position = resolve_uw_display(term)
						step_title = text_justify_center(term, position, 'AUR Helper')
						print(term.bold(term.gray_on_blue(step_title)))
						position = resolve_uw_display(term,1)
						install_yay(term, position)
						position = preserv_position
						if GNOME == True:
							step_title = text_justify_center(term, position, 'Gnome Extensions')
							print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
							position = resolve_uw_display(term,1)
							appearance_options(term, position)
							position = preserv_position
						step_title = text_justify_center(term, position, 'Apps (Misc).')
						print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
						position = resolve_uw_display(term,1)
						apps_misc(term, position)
						position = preserv_position
						step_title = text_justify_center(term, position, 'Gaming.')
						print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
						position = resolve_uw_display(term,1)
						apps_gaming(term, position)						
						position = preserv_position
						step_title = text_justify_center(term, position, 'Installing apps')
						print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
						position = resolve_uw_display(term,1)
						install_packages()
						position = preserv_position
						step_title = text_justify_center(term, position, 'Virtualization')
						print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
						position = resolve_uw_display(term,1)
						virtualization(term, position)
						STEP += 1
					case 2:
						position = preserv_position
						step_title = text_justify_center(term, position, 'Setup Complete')
						print(term.bold(term.gray_on_blue(step_title))+term.clear_eos())
						position = resolve_uw_display(term,1)
						finish_app(term,position)
						STEP += 1
					case _:
						break
		except KeyboardInterrupt:
			print('')
			exit(0)

	
if __name__ == "__main__":
    main()
